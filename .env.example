# Copia questo file in .env e compila i valori prima di eseguire
# `docker compose up -d --build` sul server.

# Porta sull'host su cui esporre il sito (per l'accesso diretto in LAN).
# Scegli un numero libero e non standard: sul server hai già molte porte occupate.
HOST_PORT=48217

# Genera un secret forte con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pubblico con cui il sito sarà raggiungibile (dietro SWAG).
# Usata anche per costruire gli URL assoluti dei metadata (anteprime social,
# sitemap, robots.txt): tienila aggiornata se cambi dominio.
NEXTAUTH_URL=https://brokenpanel.tuodominio.it

# Opzionale: da impostare SOLO se l'URL pubblico per SEO/anteprime social deve
# essere diverso da NEXTAUTH_URL. Lasciata vuota, viene usata NEXTAUTH_URL.
# SITE_URL=https://brokenpanel.tuodominio.it

# Credenziali dell'unico account admin, create automaticamente al primo avvio
ADMIN_EMAIL=admin@tuodominio.it
ADMIN_PASSWORD=cambia-questa-password

# Nome della rete Docker esterna usata da SWAG (verifica con: docker network ls)
SWAG_NETWORK_NAME=swag_default

# Testi della homepage e del footer del sito pubblico.
# Modificali e riavvia il container (`docker compose up -d`) per applicarli.
SITE_HERO_TITLE=I CLASSICI, SPEZZATI IN VIGNETTE
SITE_HERO_SUBTITLE=Broken Panel trasforma i grandi romanzi — Dumas, Stoker, Poe — in fumetti generati con l'AI, in stili visivi sempre diversi. Leggili pagina per pagina, vignetta per vignetta.
SITE_FOOTER_TEXT=© 2026 Broken Panel — Comic Publishing. Classici della letteratura reimmaginati a fumetti con l'AI.
