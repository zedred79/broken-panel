# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / uploads (local dev data)
/prisma/*.db
/prisma/*.db-journal
/uploads/*
!/uploads/.gitkeep

# dati persistenti del deploy Docker (DB + upload), bind-mount di
# docker-compose.yml — vive solo sul server, non va mai committato
/data/

# generated Prisma client (regenerated via `npx prisma generate`, includes
# platform-specific native binaries — must not be committed)
/src/generated
